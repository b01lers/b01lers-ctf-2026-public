POLICY polyglot {
    ERRNO(1) {
        mount,
        umount,
        pivot_root,
        unshare,
        setns,
        bpf,
        perf_event_open,
        userfaultfd,
        add_key,
        request_key,
        keyctl,
        ptrace,
        process_vm_readv,
        process_vm_writev,
        kexec_load,
        kexec_file_load,
        finit_module,
        init_module,
        delete_module,
        reboot,
        swapon,
        swapoff,
        acct,
        nfsservctl,
        io_uring_setup,
        io_uring_enter,
        io_uring_register
    }
}
USE polyglot DEFAULT ALLOW

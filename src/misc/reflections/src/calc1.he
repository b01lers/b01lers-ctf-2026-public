#
# CALC1 for Linux-i386-ELF
#
#   $XX  - push hex byte value onto compile-time stack
#   +    - pop two, push sum
#   -    - pop two, push difference (second - first)
#   *    - pop two, push product
#   /    - pop two, push quotient (second / first)
#   !    - getchar: read raw byte from stdin, push onto stack
#   @    - pop value from stack, output as byte
#

# Elf32_Ehdr
  7f 45 4c 46 01 01 01	# e_ident
  00 00 00 00 00 00 00 00 00
  02 00			# e_type
  03 00			# e_machine
  01 00 00 00		# e_version
  ab 81 04 08		# e_entry = _start
  34 00 00 00		# e_phoff = len(ehdr)
  00 00 00 00		# e_shoff
  00 00 00 00		# e_flags
  34 00			# e_ehsize = len(ehdr)
  20 00			# e_phentsize = len(phdr)
  01 00			# e_phnum
  00 00			# e_shentsize
  00 00			# e_shnum
  00 00			# e_shstrndx

# Elf32_Phdr
  01 00 00 00		# p_type
  00 00 00 00		# p_offset
  00 80 04 08		# p_vaddr = 0x08048000
  00 80 04 08		# p_paddr = 0x08048000
  93 02 00 00	#!	# p_filesz
  93 02 00 00	#!	# p_memsz
  07 00 00 00		# p_flags = rwx
  00 10 00 00		# p_align

# Value stack data area (256 bytes)
  00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
  00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
  00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
  00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
  00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
  00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
  00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
  00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
  00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
  00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
  00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
  00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
  00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
  00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
  00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
  00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00

# getchar:
	6a 00			# push	$0
	31 db			# xor	%ebx,%ebx
	89 e1			# mov	%esp,%ecx
	89 da			# mov	%ebx,%edx
	42			# inc	%edx
	b8 03 00 00 00		# mov	$3,%eax
	cd 80			# int	$0x80
	85 c0			# test	%eax,%eax
	74 02			# je	exit
	58			# pop	%eax
	c3			# ret

# exit:
	31 c0			# xor	%eax,%eax
	89 c3			# mov	%eax,%ebx
	40			# inc	%eax
	cd 80			# int	$0x80

# putchar:
	31 db			# xor	%ebx,%ebx
	43			# inc	%ebx
	8d 4c 24 04		# lea	4(%esp),%ecx
	89 da			# mov	%ebx,%edx
	b8 04 00 00 00		# mov	$4,%eax
	cd 80			# int	$0x80
	c3			# ret

# gethex:
	e8 cd ff ff ff		# call	getchar
	83 f8 20		# cmp	$0x20,%eax
	7e f6			# jle	gethex
	83 f8 23		# cmp	$0x23,%eax
	75 0c			# jne	convhex

# .ghex_comment:
	e8 be ff ff ff		# call	getchar
	83 f8 0a		# cmp	$0x0a,%eax
	75 f6			# jne	.ghex_comment
	eb e5			# jmp	gethex

# convhex:
	83 e8 30		# sub	$0x30,%eax
	7c e0			# jl	gethex
	83 f8 30		# cmp	$0x30,%eax
	7c 03			# jl	.ret
	83 e8 27		# sub	$0x27,%eax
# .ret:
	c3			# ret

# _start:
	be 54 80 04 08		# mov	$vstack,%esi

# main_loop:
	e8 9f ff ff ff		# call	getchar
	83 f8 20		# cmp	$0x20,%eax
	7e f6			# jle	main_loop

	83 f8 23		# cmp	$0x23,%eax	(#)
	75 0c			# jne	.not_comment

# .skip_comment:
	e8 90 ff ff ff		# call	getchar
	83 f8 0a		# cmp	$0x0a,%eax
	75 f6			# jne	.skip_comment
	eb e5			# jmp	main_loop

# .not_comment:
	83 f8 21		# cmp	$0x21,%eax	(!)
	75 0c			# jne	.not_getchar

# do_getchar:
	e8 7f ff ff ff		# call	getchar
	89 06			# mov	%eax,(%esi)
	83 c6 04		# add	$4,%esi
	eb d4			# jmp	main_loop

# .not_getchar:
	83 f8 24		# cmp	$0x24,%eax	($)
	75 19			# jne	.not_push

# do_push_hex:
	e8 9c ff ff ff		# call	gethex
	c1 e0 04		# shl	$4,%eax
	50			# push	%eax
	e8 93 ff ff ff		# call	gethex
	01 04 24		# add	%eax,(%esp)
	58			# pop	%eax
	89 06			# mov	%eax,(%esi)
	83 c6 04		# add	$4,%esi
	eb b6			# jmp	main_loop

# .not_push:
	83 f8 2a		# cmp	$0x2a,%eax	(*)
	75 14			# jne	.not_mul

# do_mul:
	83 ee 04		# sub	$4,%esi
	8b 1e			# mov	(%esi),%ebx
	83 ee 04		# sub	$4,%esi
	8b 06			# mov	(%esi),%eax
	0f af c3		# imul	%ebx,%eax
	89 06			# mov	%eax,(%esi)
	83 c6 04		# add	$4,%esi
	eb 9d			# jmp	main_loop

# .not_mul:
	83 f8 2b		# cmp	$0x2b,%eax	(+)
	75 13			# jne	.not_add

# do_add:
	83 ee 04		# sub	$4,%esi
	8b 1e			# mov	(%esi),%ebx
	83 ee 04		# sub	$4,%esi
	8b 06			# mov	(%esi),%eax
	01 d8			# add	%ebx,%eax
	89 06			# mov	%eax,(%esi)
	83 c6 04		# add	$4,%esi
	eb 85			# jmp	main_loop

# .not_add:
	83 f8 2d		# cmp	$0x2d,%eax	(-)
	75 16			# jne	.not_sub

# do_sub:
	83 ee 04		# sub	$4,%esi
	8b 1e			# mov	(%esi),%ebx
	83 ee 04		# sub	$4,%esi
	8b 06			# mov	(%esi),%eax
	29 d8			# sub	%ebx,%eax
	89 06			# mov	%eax,(%esi)
	83 c6 04		# add	$4,%esi
	e9 6a ff ff ff		# jmp	main_loop

# .not_sub:
	83 f8 2f		# cmp	$0x2f,%eax	(/)
	75 17			# jne	.not_div

# do_div:
	83 ee 04		# sub	$4,%esi
	8b 1e			# mov	(%esi),%ebx
	83 ee 04		# sub	$4,%esi
	8b 06			# mov	(%esi),%eax
	99			# cdq
	f7 fb			# idiv	%ebx
	89 06			# mov	%eax,(%esi)
	83 c6 04		# add	$4,%esi
	e9 4e ff ff ff		# jmp	main_loop

# .not_div:
	83 f8 40		# cmp	$0x40,%eax	(@)
	75 10			# jne	.hex_digit

# do_output:
	83 ee 04		# sub	$4,%esi
	ff 36			# push	(%esi)
	e8 00 ff ff ff		# call	putchar
	58			# pop	%eax
	e9 39 ff ff ff		# jmp	main_loop

# .hex_digit:
	e8 21 ff ff ff		# call	convhex
	c1 e0 04		# shl	$4,%eax
	50			# push	%eax
	e8 fd fe ff ff		# call	gethex
	01 04 24		# add	%eax,(%esp)
	e8 e4 fe ff ff		# call	putchar
	58			# pop	%eax
	e9 1d ff ff ff		# jmp	main_loop
# &&

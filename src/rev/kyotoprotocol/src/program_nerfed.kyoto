<parseloop> nop; 0 0 // i, jump_tmp, bomb_jump_target
<parseloop_start> jmp "getchar"; @1 @2 @1 // @3 = char code
<getchar_out> jz @3 "parse_finish"; @1 @2 @3 // jump out if finished
jl @3 49 "parseloop_invalid"; @1 @2 @3
jg @3 57 "parseloop_invalid"; @1 @2 @3
sub @3 49 @3; @1 @2
jmp "parseloop_ok_char"; @1 @2 @3 // jump to echo
<parseloop_invalid> nop; @1 @2 5
add @1 @3 @3; @1 @2 @3
mul @3 3 @3; @1 @2 @3
mod @3 7 @3; @1 @2 @3
add @3 81 @3; @1 @2 @3
<parseloop_ok_char> mod @1 2 @4; @1 @2 @3
jnz @4 "parseloop_place_bomb"; @1 @2 @3 // decide
set @2 @3; @1 @2
mul @2 9 @2; @1 @2
jmp "parseloop_inc"; @1 @2
<parseloop_place_bomb> add @2 @3 @2; @1
jmp "placebomb"; @1 @2
<placebomb_out> nop; @1
<parseloop_inc> add @1 1 @1; @1 @2
jmp "parseloop_start"; @1 @2

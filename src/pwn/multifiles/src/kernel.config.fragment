CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=n
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_IKCONFIG=n
CONFIG_IKCONFIG_PROC=n
CONFIG_RD_GZIP=y

CONFIG_SLUB=y
CONFIG_SLUB_CPU_PARTIAL=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SLAB_MERGE_DEFAULT=n
CONFIG_SLAB_FREELIST_RANDOM=n
CONFIG_RANDOM_KMALLOC_CACHES=n
CONFIG_SLAB_BUCKETS=n

CONFIG_SLUB_DEBUG=n
CONFIG_KASAN=n
CONFIG_KFENCE=n
CONFIG_KMSAN=n
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=n
CONFIG_INIT_ON_FREE_DEFAULT_ON=n
CONFIG_DEBUG_PAGEALLOC=n
CONFIG_PAGE_POISONING=n
CONFIG_DEBUG_INFO=n
CONFIG_DEBUG_INFO_BTF=n
CONFIG_GDB_SCRIPTS=n
CONFIG_WERROR=n

CONFIG_RANDOMIZE_BASE=y
CONFIG_X86_SMEP=y
CONFIG_X86_SMAP=y
CONFIG_PAGE_TABLE_ISOLATION=y

# reduce attack surface incase some mythos cve drop
# TODO: maybe reenabled some, some soluitons might be annoyed by lack of spraying, or could be part of challenge?

# io uring and namespaces need this to be disabled
CONFIG_EXPERT=y

CONFIG_SYSVIPC=n
CONFIG_POSIX_MQUEUE=n
CONFIG_CGROUPS=n
CONFIG_NAMESPACES=n
CONFIG_NET=n
CONFIG_IO_URING=n

CONFIG_EXT4_FS=n
CONFIG_AUTOFS_FS=n
CONFIG_NFS_FS=n
CONFIG_9P_FS=n
